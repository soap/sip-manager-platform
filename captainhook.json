{
    "commit-msg": {
        "enabled": true,
        "actions": [
            {
                "action": "\\CaptainHook\\App\\Hook\\Message\\Action\\Beams",
                "options": {
                    "subjectLength": 50,
                    "bodyLineLength": 72
                }
            }
        ]
    },
    "pre-commit": {
        "enabled": true,
        "actions": [
            {
                "action": "\\CaptainHook\\App\\Hook\\PHP\\Action\\Linting"
            },
            {
                "action": "php vendor/bin/pint",
                "options": {
                    "arguments": "--dirty --test"
                }
            },
            {
                "action": "npm run check"
            }
        ]
    },
    "pre-push": {
        "enabled": true,
        "actions": [
            {
                "action": "php vendor/bin/phpstan analyse"
            },
            {
                "action": "php artisan config:clear"
            },
            {
                "action": "php artisan test --compact"
            }
        ]
    }
}
